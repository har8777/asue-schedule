# Սերվերի պորտը
PORT=4000
HOST=0.0.0.0

# SQLite բազայի ֆայլի ճանապարհը (թղթապանակը կստեղծվի ավտոմատ)
DATABASE_FILE=./data/schedule.db

# JWT գաղտնի բանալի։ Եթե դատարկ է, կստեղծվի ավտոմատ և կպահվի բազայում։
JWT_SECRET=
# Մուտքի սեսիայի տևողությունը վայրկյաններով (12 ժամ)
JWT_TTL_SECONDS=43200

# Թույլատրված frontend հասցեներ (ստորակետով), եթե frontend-ը առանձին է տեղադրված
CORS_ORIGINS=http://localhost:5173

# Կառուցված frontend-ի թղթապանակը (npm run build-ի արդյունքը)։
# Եթե գոյություն ունի, սերվերը կմատուցի նաև կայքը։
CLIENT_DIST_DIR=../dist

# Գլխավոր ադմինիստրատոր, որը կստեղծվի առաջին գործարկման ժամանակ։
# Եթե գաղտնաբառը դատարկ է, կստեղծվի պատահական և կտպվի կոնսոլում։
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=

# true, եթե սերվերը աշխատում է nginx-ի կամ այլ reverse proxy-ի հետևում
TRUST_PROXY=false

NODE_ENV=development
